# --- Подключаются автоматически при добавлении базы и хранилища в проект на Vercel ---
POSTGRES_URL=""
BLOB_READ_WRITE_TOKEN=""

# --- Защита (задайте в Vercel → Settings → Environment Variables) ---

# Пароль для /admin (модерация). Придумайте длинный: 20+ символов. Без него админка выключена.
ADMIN_PASSWORD=""
ADMIN_USER="admin"

# Секрет для ночной очистки файлов. Любая длинная случайная строка.
CRON_SECRET=""

# Проверка «я не робот» (Cloudflare Turnstile, бесплатно): dash.cloudflare.com → Turnstile.
# Пока ключи не заданы, проверка выключена (остальная защита работает).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Соль для хэширования адресов и подпись метки «человек». Любая длинная случайная строка.
RATE_LIMIT_SALT=""
SESSION_SECRET=""

# Предохранитель: сколько приглашений можно создать за сутки на всём сервисе (по умолчанию 2000)
MAX_INVITES_PER_DAY=""

# --- Поддержка ---
# Кнопки быстрой связи на странице /support (показываются, только если заданы).
# Telegram — имя без @, WhatsApp — цифры с кодом страны.
NEXT_PUBLIC_SUPPORT_TELEGRAM=""
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Мгновенное уведомление в Telegram о каждом новом обращении (по желанию):
# создайте бота у @BotFather, возьмите его токен, напишите боту «привет»
# и узнайте свой chat id (например, у бота @userinfobot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
